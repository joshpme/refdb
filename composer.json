{
    "name": "ansto/refdb",
    "license": "MIT",
    "type": "project",
    "description": "Citation Database for JaCOW Catalog",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2.0",
        "ext-curl": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-mongodb": "*",
        "doctrine/common": "^3.4",
        "doctrine/doctrine-bundle": "^2.10",
        "doctrine/doctrine-migrations-bundle": "^3.2",
        "doctrine/orm": "^2.16",
        "friendsofsymfony/jsrouting-bundle": "^3.2",
        "jms/serializer-bundle": "^5.4",
        "knplabs/knp-paginator-bundle": "^6.3",
        "lexik/jwt-authentication-bundle": "^2.20",
        "mongodb/mongodb": "^1.15",
        "nyholm/psr7": "^1.5",
        "sentry/sentry-symfony": "^5.0",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "7.4.*",
        "symfony/config": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2.4",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/intl": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/monolog-bundle": "^3.8",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/sendgrid-mailer": "^7.4",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfonycasts/reset-password-bundle": "^1.20",
        "symfonycasts/verify-email-bundle": "^1.16",
        "twig/extra-bundle": "^3.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "doctrine/data-fixtures": "~1.6",
        "doctrine/doctrine-fixtures-bundle": "^3.5",
        "symfony/phpunit-bridge": "^7.4",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "scripts": {
        "auto-scripts": {
            "lexik:jwt:generate-keypair": "symfony-cmd",
            "assets:install --symlink --relative %PUBLIC_DIR%": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "cache:clear": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "config": {
        "sort-packages": true,
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "7.4.*"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    }
}
